diff --git a/csrc/flash_attn/src/flash.h b/csrc/flash_attn/src/flash.h
index 8ffbb62..33e30da 100644
--- a/csrc/flash_attn/src/flash.h
+++ b/csrc/flash_attn/src/flash.h
@@ -7,6 +7,7 @@
 #include "namespace_config.h"
 
 #include <cuda.h>
+#include <stdint.h>
 #include <vector>
 
 #include <ATen/cuda/CUDAGeneratorImpl.h> // For at::Generator and at::PhiloxCudaState
@@ -104,6 +105,16 @@ struct Flash_fwd_params : public Qkv_params {
     index_t block_table_batch_stride;
     int page_block_size;
 
+    // ARIS selected-head suppression metadata. When all pointers are non-null,
+    // selected query heads mask key positions aris_end_positions[bidb] and +1.
+    int * __restrict__ aris_enabled;
+    int * __restrict__ aris_budget_ids;
+    int * __restrict__ aris_end_positions;
+    uint64_t * __restrict__ aris_head_mask_table;
+    int aris_num_layers;
+    int aris_words_per_layer;
+    int aris_layer_idx;
+

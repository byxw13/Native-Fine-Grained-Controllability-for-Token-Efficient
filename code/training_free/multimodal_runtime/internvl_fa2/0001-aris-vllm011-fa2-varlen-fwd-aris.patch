+    const bool seqlenq_ngroups_swapped) {
+    if (aris_head_mask_words == nullptr || aris_end_pos < 0 || aris_words_per_layer <= 0
+            || aris_end_pos + 1 < col_idx_offset_
+            || aris_end_pos >= col_idx_offset_ + block_n) {
+        return;
+    }
+    // The ARIS native path is decode-only and Qwen3/Qwen3-VL both use GQA.
+    // FA2 swaps the query-group dimension into M in precisely this case.  A
+    // generic M-tile walk leaves a large unrolled loop in every attention
+    // kernel even though only one logical row per participating thread can be
+    // valid.  Specialize the hot path to that row and reject other layouts.
+    if (!seqlenq_ngroups_swapped || row_idx_offset >= seqlen_q) {
+        return;
+    }
+    (void)warp_row_stride;

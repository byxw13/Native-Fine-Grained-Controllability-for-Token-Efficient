diff --git a/csrc/flash_attn/src/mask.h b/csrc/flash_attn/src/mask.h
index 544065d..08c6015 100644
--- a/csrc/flash_attn/src/mask.h
+++ b/csrc/flash_attn/src/mask.h
@@ -211,4 +211,69 @@ struct Mask {
 
 };
 
+template <typename Engine, typename Layout>
+__forceinline__ __device__ void apply_aris_selected_key_mask(
+    Tensor<Engine, Layout> &tensor_,
+    const int col_idx_offset_,
+    const int block_n,
+    const int row_idx_offset,
+    const int warp_row_stride,
+    const int aris_end_pos,
+    const uint64_t *__restrict__ aris_head_mask_words,
+    const int aris_words_per_layer,
+    const int bidh,
+    const int seqlen_q,
+    const bool seqlenq_ngroups_swapped) {
+    if (aris_head_mask_words == nullptr || aris_end_pos < 0 || aris_words_per_layer <= 0
+            || aris_end_pos + 1 < col_idx_offset_
+            || aris_end_pos >= col_idx_offset_ + block_n) {
+        return;
+    }
+    // During regular prefill, only the final query row produces the first
+    // free-generation logits.  During the FA2 decode GQA optimization, query
+    // groups are folded into M and every valid folded row represents one
+    // query head.  Supporting both layouts is required for initial K to affect
+    // the very first free-generation forward without perturbing earlier
+    // prompt rows.
+    uint64_t first_mask_word = 0;
+    if (aris_words_per_layer == 1) {
+        first_mask_word = aris_head_mask_words[0];
+        if (first_mask_word == 0) { return; }
+    }
+    static_assert(Layout::rank == 3, "Only support 3D Tensor");
+    Tensor tensor = make_tensor(tensor_.data(), FLASH_NAMESPACE::convert_layout_acc_rowcol(tensor_.layout()));
+    const int lane_id = threadIdx.x % 32;
+    const int col_idx_offset = col_idx_offset_ + (lane_id % 4) * 2;
+    #pragma unroll
+    for (int mi = 0; mi < size<0, 1>(tensor); ++mi) {
+        const int row_idx_base = row_idx_offset + mi * warp_row_stride;
+        #pragma unroll
+        for (int i = 0; i < size<0, 0>(tensor); ++i) {
+            const int row_idx = row_idx_base + i * 8;
+            if (row_idx < 0 || row_idx >= seqlen_q) { continue; }
+            if (!seqlenq_ngroups_swapped && row_idx != seqlen_q - 1) { continue; }
+            const int query_head = seqlenq_ngroups_swapped
+                ? bidh * seqlen_q + row_idx
+                : bidh;
+            const int word_idx = query_head >> 6;
+            const int bit_idx = query_head & 63;
+            if (word_idx < 0 || word_idx >= aris_words_per_layer
+                    || ((aris_head_mask_words[word_idx] >> bit_idx) & uint64_t(1)) == 0) {
+                continue;
+            }
+            #pragma unroll
+            for (int nj = 0; nj < size<1, 1>(tensor); ++nj) {
+                const int col_idx_base = col_idx_offset + nj * 8;
+                #pragma unroll
+                for (int j = 0; j < size<1, 0>(tensor); ++j) {
+                    const int col_idx = col_idx_base + j;
+                    if (col_idx == aris_end_pos || col_idx == aris_end_pos + 1) {
+                        tensor(make_coord(i, mi), make_coord(j, nj)) = -INFINITY;
+                    }
+                }
+            }
+        }
+    }
+}
+
 } // namespace FLASH_NAMESPACE
